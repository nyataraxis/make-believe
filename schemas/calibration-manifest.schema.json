{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://make-believe.local/schemas/calibration-manifest.schema.json",
  "title": "Phase 0 calibration manifest",
  "type": "object",
  "required": ["id", "displayName", "language", "mode", "recordings"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "mode": {"enum": ["speech", "singing"]},
    "formantCeilingHz": {"type": "number", "minimum": 4000, "maximum": 6500},
    "recordings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "vowel": {"enum": ["a", "i", "u", "e", "o"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
