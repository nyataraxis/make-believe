{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://make-believe.local/schemas/speaker-profile.schema.json",
  "title": "Research speaker profile v1",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "language", "mode", "recording", "pitch", "vocalTract", "sourceQuality", "spectral", "dynamics", "sibilance", "quality", "analysisSoftware", "provenance"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "mode": {"enum": ["speech", "singing"]},
    "recording": {
      "type": "object",
      "required": ["sampleRate", "channels", "usableDurationSeconds"],
      "properties": {
        "sampleRate": {"type": "integer", "minimum": 16000},
        "channels": {"const": 1},
        "usableDurationSeconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "pitch": {
      "type": "object",
      "required": ["voicedFraction", "log2HzQuantiles", "medianHz", "rangeCents", "contourVelocity"],
      "properties": {
        "voicedFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "medianHz": {"type": "number", "exclusiveMinimum": 0},
        "log2HzQuantiles": {
          "type": "object",
          "required": ["q05", "q10", "q25", "q50", "q75", "q90", "q95"],
          "properties": {
            "q05": {"type": "number"}, "q10": {"type": "number"}, "q25": {"type": "number"},
            "q50": {"type": "number"}, "q75": {"type": "number"}, "q90": {"type": "number"}, "q95": {"type": "number"}
          }
        },
        "contourVelocity": {"type": ["object", "null"]}
      }
    },
    "vocalTract": {
      "type": "object",
      "required": ["vowels", "formantSpacingHzMedian", "estimatedGlobalWarp", "confidence"],
      "properties": {
        "vowels": {"type": "object"},
        "formantSpacingHzMedian": {"type": ["number", "null"]},
        "estimatedGlobalWarp": {"type": ["number", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "sourceQuality": {"type": "object"},
    "spectral": {
      "type": "object",
      "required": ["analysisBandsHz", "meanEnvelopeDb", "envelopeStdDb"],
      "properties": {
        "analysisBandsHz": {"type": "array", "minItems": 8, "items": {"type": "number"}},
        "meanEnvelopeDb": {"type": "array", "minItems": 8, "items": {"type": "number"}},
        "envelopeStdDb": {"type": "array", "minItems": 8, "items": {"type": "number"}}
      }
    },
    "dynamics": {"type": "object"},
    "sibilance": {"type": "object"},
    "quality": {"type": "object"},
    "analysisSoftware": {"type": "object"},
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256", "durationSeconds", "peakDbFS"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    }
  }
}
